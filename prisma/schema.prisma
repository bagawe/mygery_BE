generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int                       @id @default(autoincrement())
  uuid                     String                    @unique @default(uuid())
  name                     String
  email                    String                    @unique
  username                 String                    @unique
  password                 String
  isActive                 Boolean                   @default(true)
  lastLogin                DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  bio                      String?
  fotoKtp                  String?                   @db.VarChar(255)
  fotoProfil               String?                   @db.VarChar(255)
  jalan                    String?                   @db.VarChar(255)
  jenisKelamin             String?                   @db.VarChar(20)
  kecamatan                String?                   @db.VarChar(100)
  kegiatan                 String?
  kelurahan                String?                   @db.VarChar(100)
  kota                     String?                   @db.VarChar(100)
  nik                      String?                   @db.VarChar(16)
  pekerjaan                String?                   @db.VarChar(100)
  pendidikan               String?                   @db.VarChar(50)
  phone                    String?
  provinsi                 String?                   @db.VarChar(100)
  rt                       String?                   @db.VarChar(3)
  rw                       String?                   @db.VarChar(3)
  statusKawin              String?                   @db.VarChar(20)
  tanggalLahir             DateTime?
  tempatLahir              String?                   @db.VarChar(100)
  underbow                 String?                   @db.VarChar(255)
  ktaVerified              Boolean                   @default(false)
  ktaVerifiedAt            DateTime?
  ktaVerifiedBy            Int?
  
  // ⭐ NEW: Kader Confirmation Fields
  kaderPoint1Confirmed     Boolean                   @default(false)
  kaderPoint1ConfirmedAt   DateTime?
  kaderPoint1ConfirmedBy   Int?
  kaderPoint2Confirmed     Boolean                   @default(false)
  kaderPoint2ConfirmedAt   DateTime?
  kaderPoint2ConfirmedBy   Int?
  
  // ⭐ NEW: Device IP & Blocking Fields
  deviceIp                 String?                   @db.VarChar(45)
  isBlocked                Boolean                   @default(false)
  blockedAt                DateTime?
  blockedByAdmin           Int?
  blockReason              String?                   @db.Text
  
  conversationParticipants ConversationParticipant[]
  logEntries               LogActivity[]
  messages                 Message[]
  refreshTokens            RefreshToken[]
  blockedBy                UserBlock[]               @relation("UserBlocked")
  blocking                 UserBlock[]               @relation("UserBlocker")
  userHistory              UserHistory[]
  roles                    UserRole[]
  posts                    Post[]
  postLikes                PostLike[]
  postComments             PostComment[]
  mentions                 Mention[]                 @relation("UserMentions")    // ✅ NEW
  postViews                PostView[]                @relation("PostViews")       // ✅ NEW
  location                 UserLocation?             @relation("UserLocation")    // ✅ RADAR
  locationHistory          LocationHistory[]         @relation("LocationHistory") // ✅ RADAR
  notificationsReceived    Notification[]            @relation("NotificationReceiver") // ✅ NOTIFICATION
  notificationsSent        Notification[]            @relation("NotificationSender")   // ✅ NOTIFICATION
  
  @@index([ktaVerified])
  @@index([ktaVerifiedAt])
  @@index([deviceIp])
  @@index([isBlocked])
  @@index([kaderPoint1Confirmed])
  @@index([kaderPoint2Confirmed])
}

model Post {
  id         Int            @id @default(autoincrement())
  userId     Int
  content    String?        @db.Text
  imageUrl   String?        @db.VarChar(255)  // Keep for backward compatibility
  imageUrls  Json?          // NEW: Array untuk multiple images
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes      PostLike[]     @relation("PostLikes")
  comments   PostComment[]  @relation("PostComments")
  hashtags   PostHashtag[]  @relation("PostHashtags")
  mentions   Mention[]      @relation("PostMentions")
  views      PostView[]       // ✅ NEW
  trending   TrendingPost?    // ✅ NEW
  history     UserHistory[]   @relation("PostHistory") // ✅ NEW: Relation for mention history
  notifications Notification[] @relation("NotificationPost") // ✅ NOTIFICATION

  @@index([userId])
  @@index([createdAt])
  @@map("posts")
}

model PostLike {
  id        Int      @id @default(autoincrement())
  post      Post     @relation("PostLikes", fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model PostComment {
  id        Int      @id @default(autoincrement())
  post      Post     @relation("PostComments", fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  content   String   // ✅ FIXED: comment -> content (sesuai service)
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([userId])
}

model UserRole {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  userId      Int
  role        Role
  isActive    Boolean  @default(true)
  profileData Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])  // Prevent duplicate role per user → fix double data bug
  @@index([userId])
  @@index([role])
}

model LogActivity {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  details   Json?
  ipAddress String?
  userAgent String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int
  isRevoked Boolean   @default(false)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Conversation {
  id           Int                       @id @default(autoincrement())
  uuid         String                    @unique @default(uuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt(sort: Desc)])
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  userId         Int
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             Int          @id @default(autoincrement())
  uuid           String       @unique @default(uuid())
  conversationId Int
  senderId       Int?
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?        @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([conversationId, isRead])
}

model UserBlock {
  id            Int      @id @default(autoincrement())
  blockerId     Int
  blockedUserId Int
  createdAt     DateTime @default(now())
  blockedUser   User     @relation("UserBlocked", fields: [blockedUserId], references: [id], onDelete: Cascade)
  blocker       User     @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@index([blockerId])
  @@index([blockedUserId])
}

model UserHistory {
  id          Int         @id @default(autoincrement())
  userId      Int
  type        HistoryType
  description String?
  postId      Int?     // ✅ NEW: ID postingan untuk mention/tag
  metadata    Json?
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  post        Post?       @relation("PostHistory", fields: [postId], references: [id], onDelete: SetNull) // ✅ NEW: Relation to Post

  @@index([userId])
  @@index([postId]) // ✅ NEW: Index for postId
  @@index([type])
  @@index([createdAt(sort: Desc)])
}

// ✅ NEW MODELS FOR HASHTAGS, MENTIONS & TRENDING

model Hashtag {
  id        Int               @id @default(autoincrement())
  name      String            @unique @db.VarChar(50)
  count     Int               @default(0) // Total posts using this hashtag
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  posts     PostHashtag[]

  @@index([name])
  @@index([count])
}

model PostHashtag {
  id        Int      @id @default(autoincrement())
  postId    Int
  hashtagId Int
  createdAt DateTime @default(now())

  post    Post    @relation("PostHashtags", fields: [postId], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([postId, hashtagId])
  @@index([postId])
  @@index([hashtagId])
}

model Mention {
  id          Int      @id @default(autoincrement())
  postId      Int
  mentionedId Int      // User yang di-mention
  createdAt   DateTime @default(now())

  post      Post @relation("PostMentions", fields: [postId], references: [id], onDelete: Cascade)
  mentioned User @relation("UserMentions", fields: [mentionedId], references: [id], onDelete: Cascade)

  @@unique([postId, mentionedId])
  @@index([postId])
  @@index([mentionedId])
}

model PostView {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int?     // Null jika anonymous view
  viewedAt  DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User? @relation("PostViews", fields: [userId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([userId])
  @@index([viewedAt])
}

model TrendingPost {
  id           Int      @id @default(autoincrement())
  postId       Int      @unique
  score        Float    // Trending score
  lastUpdated  DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([score])
  @@index([lastUpdated])
}

enum Role {
  simpatisan
  kader
  admin
}

enum HistoryType {
  login
  logout
  open_app
  edit_profile
  search_user
  mention       // ✅ NEW
  tag           // ✅ NEW
  create_post   // ✅ NEW
}

// ✅ NEW: RADAR FEATURE MODELS

model UserLocation {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  latitude          Decimal  @db.Decimal(10, 8)
  longitude         Decimal  @db.Decimal(11, 8)
  accuracy          Float?
  lastUpdate        DateTime @default(now()) @updatedAt
  isSharingEnabled  Boolean  @default(false)
  isSavedLocation   Boolean  @default(false)
  createdAt         DateTime @default(now())

  user User @relation("UserLocation", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastUpdate])
  @@index([isSharingEnabled])
  @@index([isSharingEnabled, lastUpdate])
  @@index([isSavedLocation])
  @@map("user_locations")
}

model LocationHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  latitude  Decimal  @db.Decimal(10, 8)
  longitude Decimal  @db.Decimal(11, 8)
  accuracy  Float?
  timestamp DateTime @default(now())

  user User @relation("LocationHistory", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([timestamp])
  @@map("location_history")
}

// ⭐ NEW: AGENDA MODEL
model Agenda {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String?  @db.Text
  date        DateTime @db.Date
  time        String?  @db.VarChar(10)
  location    String?  @db.VarChar(255)
  createdBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([createdBy])
  @@map("agendas")
}

// ⭐ NEW: ANNOUNCEMENT MODEL
model Announcement {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(255)
  content   String?  @db.Text
  imageUrl  String?  @db.VarChar(500)
  type      AnnouncementType @default(pengumuman)
  isActive  Boolean  @default(true)
  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
  @@index([createdBy])
  @@index([createdAt])
  @@map("announcements")
}

enum AnnouncementType {
  sambutan
  pengumuman
  download
  artikel
}

// ⭐ NEW: VOTING SYSTEM MODELS
model Voting {
  id                Int              @id @default(autoincrement())
  uuid              String           @unique @default(uuid())
  title             String           @db.VarChar(255)
  question          String           @db.Text
  questionImageUrl  String?          @db.VarChar(500)
  votingType        VotingType       @default(single)
  deadline          DateTime
  isActive          Boolean          @default(true)
  createdBy         Int
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  options           VotingOption[]
  responses         VotingResponse[]

  @@index([isActive])
  @@index([deadline])
  @@index([createdBy])
  @@index([createdAt])
  @@map("votings")
}

model VotingOption {
  id              Int      @id @default(autoincrement())
  votingId        Int
  optionText      String   @db.VarChar(500)
  optionImageUrl  String?  @db.VarChar(500)
  orderIndex      Int      @default(0)
  createdAt       DateTime @default(now())
  
  voting          Voting   @relation(fields: [votingId], references: [id], onDelete: Cascade)

  @@index([votingId])
  @@index([orderIndex])
  @@map("voting_options")
}

model VotingResponse {
  id              Int      @id @default(autoincrement())
  votingId        Int
  userId          Int
  selectedOptions Json     // Array of option IDs: [1, 3, 5] or [2]
  answeredAt      DateTime @default(now())
  
  voting          Voting   @relation(fields: [votingId], references: [id], onDelete: Cascade)

  @@unique([votingId, userId]) // Satu user hanya bisa vote 1x per voting
  @@index([votingId])
  @@index([userId])
  @@index([answeredAt])
  @@map("voting_responses")
}

enum VotingType {
  single      // Hanya bisa pilih 1 jawaban
  multiple    // Bisa pilih beberapa jawaban
}

// ⭐ NEW: NOTIFICATION MODEL
model Notification {
  id              Int              @id @default(autoincrement())
  userId          Int              // Penerima notifikasi
  type            NotificationType
  postId          Int?
  commentId       Int?
  fromUserId      Int              // Pengirim/pelaku aksi
  fromUserName    String           @db.VarChar(255)
  fromUserUsername String          @db.VarChar(255)
  message         String?          @db.Text
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user     User  @relation("NotificationReceiver", fields: [userId], references: [id], onDelete: Cascade)
  fromUser User  @relation("NotificationSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  post     Post? @relation("NotificationPost", fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([fromUserId])
  @@map("notifications")
}

enum NotificationType {
  like
  comment
}

// ⭐ NEW: ONBOARDING SLIDES MODEL
model OnboardingSlide {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique @default(uuid())
  order           Int       @default(0)
  title           String?   @db.VarChar(255)
  description     String?   @db.Text
  imageUrl        String?   @db.VarChar(500)
  backgroundColor String?   @db.VarChar(7)
  type            OnboardingType @default(title_image)
  skipAllowed     Boolean   @default(true)
  isActive        Boolean   @default(true)
  createdBy       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([order])
  @@index([isActive])
  @@index([createdAt])
  @@map("onboarding_slides")
}

enum OnboardingType {
  title_image
  title_text
  image_only
  text_only
  title_image_text
}